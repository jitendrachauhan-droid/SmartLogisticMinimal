{
  "Jwt": {
    "Issuer": "SmartLogistics.AuthService",
    "Audience": "SmartLogistics.Api"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "warehouse-route": {
        "ClusterId": "warehouse-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/warehouses/{**catch-all}" }
      },
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/deliveries/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": { "Destinations": { "destination": { "Address": "http://localhost:5084/" } } },
      "customer-cluster": { "Destinations": { "destination": { "Address": "http://localhost:5009/" } } },
      "order-cluster": { "Destinations": { "destination": { "Address": "http://localhost:5073/" } } },
      "inventory-cluster": { "Destinations": { "destination": { "Address": "http://localhost:5160/" } } },
      "warehouse-cluster": { "Destinations": { "destination": { "Address": "http://localhost:5250/" } } },
      "delivery-cluster": { "Destinations": { "destination": { "Address": "http://localhost:5005/" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
