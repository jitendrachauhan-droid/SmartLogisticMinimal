{
  "Jwt": {
    "Issuer": "SmartLogistics.AuthService",
    "Audience": "SmartLogistics.Api",
    "SigningKey": "f5PF60kaR7yVDSPH4kZ5ZxxI9l5Zd6fcfILS+veDfRE="
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "customer-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },

      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },

      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },

      "warehouse-route": {
        "ClusterId": "warehouse-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/warehouses/{**catch-all}"
        }
      },

      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        }
      },
      "auth-openapi-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/openapi/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "customer-openapi-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/openapi/customers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "order-openapi-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/openapi/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "inventory-openapi-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/openapi/inventory/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "warehouse-openapi-route": {
        "ClusterId": "warehouse-cluster",
        "Match": {
          "Path": "/openapi/warehouses/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "delivery-openapi-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/openapi/deliveries/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://localhost:5084/"
          }
        }
      },

      "customer-cluster": {
        "Destinations": {
          "destination": {
